# AttendX AI Environment Configuration Template
# Target: ZEAL College of Engineering & Research, Pune

ENVIRONMENT=development
DEBUG=True
APP_NAME="AttendX AI"
APP_VERSION="1.0.0"

# Secret Key for JWT & Security Token Signing (Must be cryptographically random 64-char string in production)
SECRET_KEY=attendx_dev_secret_key_change_in_production_min_32_bytes_long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default local dev: SQLite database with async/sync engine
# Production / Staging: postgresql+psycopg2://user:password@localhost:5432/attendx
DATABASE_URL=sqlite:///./attendx.db

# Dynamic QR & PIN Settings
QR_REFRESH_INTERVAL_SECONDS=30
CHECKIN_WINDOW_MINUTES=5
PIN_DIGITS=6
PIN_MAX_ATTEMPTS=5

# Geofence Settings (Default: ZEAL College Campus, Narhe, Pune)
# 18.4485° N, 73.8245° E (ZEAL College of Engineering and Research)
CAMPUS_DEFAULT_LATITUDE=18.4485
CAMPUS_DEFAULT_LONGITUDE=73.8245
CAMPUS_DEFAULT_RADIUS_METERS=100.0

# Face Verification & Liveness Provider Settings
# Options: internal_face_mesh, simulated_strict_mock, aws_rekognition, azure_face
FACE_VERIFIER_PROVIDER=internal
FACE_SIMILARITY_THRESHOLD=0.75
LIVENESS_PROVIDER=passive_challenge
LIVENESS_REQUIRED=True

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CHECKIN_PER_MINUTE=20

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
